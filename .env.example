# ============================================================
# BASE NETWORK SNIPER BOT - ENVIRONMENT CONFIGURATION
# ============================================================

# --- RPC ---
# Gunakan RPC yang support WebSocket untuk subscribe events
BASE_RPC_WS=wss://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_HTTP=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# --- WALLET ---
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# --- API KEYS ---
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# --- TRADE SETTINGS ---
# Persentase maksimal saldo per trade (0.4 = 40%)
MAX_POSITION_SIZE_PCT=0.4
# Maksimal posisi terbuka bersamaan
MAX_OPEN_POSITIONS=2
# Minimal trade dalam ETH
MIN_TRADE_ETH=0.001
# Slippage dalam persen (5 = 5%)
SLIPPAGE_PCT=5
# Gas limit manual (0 = auto)
GAS_LIMIT=500000
# Gas price dalam Gwei (0 = auto dari provider)
GAS_PRICE_GWEI=0

# --- TAKE PROFIT LEVELS ---
# Level 1: profit 25% → jual 30% posisi
TP1_PCT=25
TP1_SELL_PCT=30
# Level 2: profit 50% → jual 30% posisi
TP2_PCT=50
TP2_SELL_PCT=30
# Level 3: profit 100% → jual 20% posisi
TP3_PCT=100
TP3_SELL_PCT=20
# Sisa 20% di-hold

# --- STOP LOSS ---
# Hard SL: 15% dari entry price
SL_PCT=15
# Trailing stop aktif setelah profit >20%
TRAILING_ACTIVATE_PCT=20
# Jarak trailing dari all-time-high: 5%
TRAILING_DISTANCE_PCT=5

# --- TIME EXIT ---
# Jual jika holding >2 jam dan profit <5%
TIME_EXIT_HOURS=2
TIME_EXIT_MIN_PROFIT_PCT=5

# --- SECURITY THRESHOLDS ---
# Minimal likuiditas dalam USD
MIN_LIQUIDITY_USD=5000
# Maksimal tax (buy atau sell)
MAX_TAX_PCT=10
# Maksimal risk score untuk lanjut trade
MAX_RISK_SCORE=30
# Maksimal top-10 holder concentration (persen supply) sebelum risk naik
HOLDER_CONCENTRATION_THRESHOLD=30

# --- MONITORING ---
# Interval monitoring posisi dalam milidetik (5000 = 5 detik)
MONITOR_INTERVAL_MS=5000
